{
  "name": "kittykingdom",
  "version": "1.1.0",
  "license": "",
  "author": "patrick hammond",
  "description": "",
  "engines": {
    "node": "~8.11.0",
    "npm": "~5.8.0"
  },
  "scripts": {
    "start": "esbuild ./src/Main.ts --bundle --watch --outfile=./dist/out.js",
    "build": "esbuild ./src/Main.ts --bundle --outfile=./dist/out.js",
    "deploy": "esbuild ./src/Main.ts --bundle --outfile=./dist/out.js --minify --sourcemap --target=chrome58,firefox57,safari11,edge16",
    "npm-clean-install": "rmdir /s node_modules && npm cache verify && npm i",
    "update-libs": "npm uninstall breakspace && npm install Patrick-Hammond/breakspace"
  },
  "keywords": [],
  "dependencies": {
    "breakspace": "github:Patrick-Hammond/breakspace",
    "eventemitter3": "^4.0.0",
    "gsap": "^3.2.6",
    "nipplejs": "^0.8.5",
    "pixi-filters": "^3.1.1",
    "pixi-sound": "^3.0.4",
    "pixi-tilemap": "^2.0.6",
    "pixi.js": "5.2.1",
    "screenfull-es6": "^0.1.3",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^13.11.0",
    "esbuild": "^0.11.16",
    "tslint": "^6.1.1",
    "typescript": "^3.8.3"
  }
}
